# Optional overrides for local layout
NAILD_WEBAPP_PATH=../Naild-WebApp/naild-website
SPRINGBOOT_PATH=../security

# Optional service overrides
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080
NEXT_PUBLIC_AI_BASE=http://localhost:8081
SPRING_API_BASE=http://springboot:8080/api/v1
OLLAMA_HOST=http://host.docker.internal:11434

# Required secrets for the Spring security service
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
APP_JWT_SECRET=replace-with-base64-jwt-secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=replace-with-google-client-id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
